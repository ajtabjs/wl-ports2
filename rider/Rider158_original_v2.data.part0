@␀␀D␀␀␀F@À␀„␀€␀\€␀	@␀€E€␀␀FÀÀ␀␀␀À␀␀␀\@€␀€␀␀␀␀␀␀␀systemOptions␀␀␀␀encode␀␀␀␀system␀␀␀␀setPreferences␀␀␀␀app␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀-- code.config.options - HTML5 compatibility repair
-- Reconstructed from the Rider Lua 5.1 bytecode module.
-- Keeps the original public API and defaults, with guarded storage loading.

local properties = require("code.config.properties")
require("code.config.ice")
local json = require("json")

local options = {}
local data = {}

local SAVE_FILE = "rider_progress.json"

local function readLocalProgress()
    if type(system) ~= "table"
        or type(system.pathForFile) ~= "function"
        or system.DocumentsDirectory == nil
        or type(io) ~= "table"
        or type(io.open) ~= "function" then
        return nil
    end

    local okPath, path = pcall(
        system.pathForFile,
        SAVE_FILE,
        system.DocumentsDirectory
    )

    if not okPath or not path then
        return nil
    end

    local okOpen, file = pcall(io.open, path, "r")

    if not okOpen or not file then
        return nil
    end

    local okRead, contents = pcall(function()
        return file:read("*a")
    end)

    pcall(function() file:close() end)

    if not okRead or type(contents) ~= "string" or contents == "" then
        return nil
    end

    local okDecode, saved = pcall(json.decode, contents)

    if okDecode and type(saved) == "table" then
        print("[RIDER SAVE] Local progress loaded")
        return saved
    end

    print("[RIDER SAVE] Local save could not be decoded")
    return nil
end

-- Original game defaults.
options.sound = 1
options.music = 1
options.previousScore = 0
options.bestScore = 0
options.currency = 200
options.todaysBest = { value = 0, date = false }
options.tutorialMode = true
options.charactersTable = { ["1"] = true }
options.unlockedScapes = { ["1"] = true, ["2"] = true, ["3"] = true }
options.activeScapes = { ["1"] = true, ["2"] = true, ["3"] = true }
options.optionsDefaults = {}
options.newBestScore = false
options.challengeTaskTimesCompleted = {
    fixed = { ch1 = 0 },
    infinitive = { ch1 = 0 }
}
options.gameStatistics = properties.defaultGameStatisticsTable
options.levels = {}

local categories = properties.levelsCategories
if type(categories) ~= "table" then
    error("code.config.properties.levelsCategories is missing or is not a table")
end

for i = 1, 4 do
    local category = categories[i]
    if category ~= nil then
        options.levels[category] = {}
    else
        print("[OPTIONS] Missing levelsCategories[" .. i .. "]; skipped")
    end
end

options.challengesSkipped = 0
options.currentChallengeRuns = 0
options.lastSavedGAProgress = 0
options.dailyRewardsNotificationQuestion = true
options.dailyRewardsNotificationEnabled = false
options.askForLocalNotifications = true
options.dailyRewards = {}
options.achievements = {}
options.tutorialCompleted = false
options.slotMachineDrawCount = 0
options.doubleCurrency = false
options.lastCompletedChallengeIndex = 0
options.choosenCharacterId = "1"
options.gameOverSinceLastAd = 0
options.gameOverSinceLastRemoveAd = 5
options.gameOverSinceLastDoubleValueIAP = 5
options.gameOverSinceLastRateUs = 20
options.lastTimeAdShown = 0
options.appRated = false
options.firstLaunch = true
options.gameOverSinceLastFreeVideoReward = 0
options.unlockCharacterButtonIgnoreCount = 0
options.lastUnlockedScapeIndex = 1
options.lastTaskCompleted = 0
options.gameOverSinceLastUntilCharacterWidget = 0
options.gameOverSinceLastCpsWidgetShown = 0
options.screenshotHeight = 0
options.screenshotAdditionalY = 0
options.bonusWords = {}
options.installationReported = false
options.initGameNetworkLogin = false
options.adsUserId = math.random()

local db = nil
local dbBackup = nil

local function loadBoxSafely(name)
    if type(ice) ~= "table" or type(ice.loadBox) ~= "function" then
        print("[OPTIONS] ICE is unavailable; cannot load box " .. tostring(name))
        return nil
    end

    local ok, box = pcall(function()
        return ice:loadBox(name)
    end)

    if not ok then
        print("[OPTIONS] ICE loadBox failed for " .. tostring(name) .. ": " .. tostring(box))
        return nil
    end

    return box
end

local function retrieveSafely(box, key)
    if type(box) ~= "table" or type(box.retrieve) ~= "function" then
        return nil
    end

    local ok, value = pcall(function()
        return box:retrieve(key)
    end)

    if not ok then
        print("[OPTIONS] ICE retrieve failed for " .. tostring(key) .. ": " .. tostring(value))
        return nil
    end

    if type(value) == "table" then
        return value
    end

    return nil
end

local function loadSavedOptions()
    local localSaved = readLocalProgress()
    if localSaved then
        return localSaved
    end
    db = loadBoxSafely("options")
    dbBackup = loadBoxSafely("options_backup")

    local preference = nil
    if type(system) == "table" and type(system.getPreference) == "function" then
        local ok, result = pcall(system.getPreference, "app", "systemOptions")
        if ok then
            preference = result
        else
            print("[OPTIONS] getPreference failed: " .. tostring(result))
        end
    end

    -- The original bytecode assumed json.decode always returned a table.
    -- HTML5 storage can contain an empty, stale, or malformed preference.
    if preference ~= nil then
        local decodeOK, decoded = pcall(json.decode, preference)
        if decodeOK and type(decoded) == "table" then
            print("[OPTIONS] Loaded preferences from systemOptions")
            return decoded
        end

        print("[OPTIONS] systemOptions could not be decoded as a table; trying ICE storage")
        if not decodeOK then
            print("[OPTIONS] JSON decode error: " .. tostring(decoded))
        else
            print("[OPTIONS] JSON decode returned: " .. type(decoded))
        end
    end

    local recovered = retrieveSafely(db, "options")
    if recovered then
        print("[OPTIONS] Recovered preferences from ICE options box")
        return recovered
    end

    recovered = retrieveSafely(dbBackup, "options")
    if recovered then
        print("[OPTIONS] Recovered preferences from ICE backup box")
        return recovered
    end

    print("[OPTIONS] No valid saved options found; using game defaults")
    return {}
end

local tableMergeKeys = {
    players = true,
    optionsDefaults = true,
    dailyRewards = true,
    achievements = true,
    gameStatistics = true,
    charactersTable = true,
    activeScapes = true,
    previousChallengeProgress = true,
    currentChallengeProgressOpt = true,
    challengeTaskTimesCompleted = true,
    levels = true,
    todaysBest = true,
    currentDynamicChallenge = true,
    bonusWords = true,
    unlockedScapes = true
}

local function mergeDefaults(saved)
    if type(saved) ~= "table" then
        saved = {}
    end

    for key, defaultValue in pairs(options) do
        if type(defaultValue) ~= "function" then
            local shouldMerge = type(defaultValue) ~= "table" or tableMergeKeys[key]

            if shouldMerge and saved[key] == nil then
                if type(defaultValue) == "table" then
                    local copy = {}
                    for k, v in pairs(defaultValue) do
                        copy[k] = v
                    end
                    saved[key] = copy
                else
                    saved[key] = defaultValue
                end
            end

            if key == "optionsDefaults" then
                if type(saved[key]) ~= "table" then
                    saved[key] = {}
                end

                for k, v in pairs(defaultValue) do
                    if saved[key][k] ~= v then
                        saved[key][k] = v
                    end
                end
            end
        end
    end

    return saved
end

function options.init()
    local saved = loadSavedOptions()
    data = mergeDefaults(saved)
    -- Do not immediately overwrite potentially recoverable HTML5 storage.
    -- The next normal save will persist the repaired table.
    options.update(data, true)
end

function options.set(key, value, skipStore)
    options.save(key, value, skipStore)
end

function options.add(key, amount, skipStore)
    local current = data[key]
    if type(amount) ~= "number" or type(current) ~= "number" then
        if DEVELOPMENT_MODE then
            assert(false, "Cannot increment non number variable!")
        end
        return
    end

    options.save(key, current + amount, skipStore)
end

function options.get(key)
    return data[key]
end

function options.save(key, value, skipStore)
    data[key] = value
    if not skipStore then
        options.store()
    end
end

function options.update(newData, skipStore)
    if type(newData) ~= "table" then
        print("[OPTIONS] update received non-table; keeping existing data")
        return
    end

    data = newData
    if not skipStore then
        options.store()
    end
end

function options.store()
    local okEncode, encoded = pcall(json.encode, data)

    if not okEncode or type(encoded) ~= "string" then
        print("[RIDER SAVE] JSON encode failed: " .. tostring(encoded))
        return false
    end

    local fileSaved = false

    if type(system) == "table"
        and type(system.pathForFile) == "function"
        and system.DocumentsDirectory ~= nil
        and type(io) == "table"
        and type(io.open) == "function" then

        local okPath, path = pcall(
            system.pathForFile,
            SAVE_FILE,
            system.DocumentsDirectory
        )

        if okPath and path then
            local okOpen, file = pcall(io.open, path, "w")

            if okOpen and file then
                local okWrite, writeError = pcall(function()
                    file:write(encoded)
                    file:flush()
                    file:close()
                end)

                if okWrite then
                    fileSaved = true
                else
                    pcall(function() file:close() end)
                    print("[RIDER SAVE] File write failed: " .. tostring(writeError))
                end
            end
        end
    end

    local preferenceSaved = false

    if type(system) == "table"
        and type(system.setPreferences) == "function" then

        local okStore, result = pcall(function()
            return system.setPreferences("app", {
                systemOptions = encoded
            })
        end)

        preferenceSaved = okStore and result ~= false
    end

    if fileSaved then
        print("[RIDER SAVE] Progress saved locally")
    end

    return fileSaved or preferenceSaved
end

options.init()

-- HTML5 automatic progress saving
if Runtime and type(Runtime.addEventListener) == "function" then
    pcall(function()
        Runtime:addEventListener("system", function(event)
            if event and (
                event.type == "applicationSuspend"
                or event.type == "applicationExit"
            ) then
                options.store()
            end
        end)
    end)
end

if timer and type(timer.performWithDelay) == "function" then
    pcall(function()
        timer.performWithDelay(5000, function()
            options.store()
        end, 0)
    end)
end

return options
-- code.config.options - HTML5 compatibility repair
-- Reconstructed from the Rider Lua 5.1 bytecode module.
-- Keeps the original public API and defaults, with guarded storage loading.

local properties = require("code.config.properties")
require("code.config.ice")
local json = require("json")

local options = {}
local data = {}

-- Original game defaults.
options.sound = 1
options.music = 1
options.previousScore = 0
options.bestScore = 0
options.currency = 200
options.todaysBest = { value = 0, date = false }
options.tutorialMode = true
options.charactersTable = { ["1"] = true }
options.unlockedScapes = { ["1"] = true, ["2"] = true, ["3"] = true }
options.activeScapes = { ["1"] = true, ["2"] = true, ["3"] = true }
options.optionsDefaults = {}
options.newBestScore = false
options.challengeTaskTimesCompleted = {
    fixed = { ch1 = 0 },
    infinitive = { ch1 = 0 }
}
options.gameStatistics = properties.defaultGameStatisticsTable
options.levels = {}

local categories = properties.levelsCategories
if type(categories) ~= "table" then
    error("code.config.properties.levelsCategories is missing or is not a table")
end

for i = 1, 4 do
    local category = categories[i]
    if category ~= nil then
        options.levels[category] = {}
    else
        print("[OPTIONS] Missing levelsCategories[" .. i .. "]; skipped")
    end
end

options.challengesSkipped = 0
options.currentChallengeRuns = 0
options.lastSavedGAProgress = 0
options.dailyRewardsNotificationQuestion = true
options.dailyRewardsNotificationEnabled = false
options.askForLocalNotifications = true
options.dailyRewards = {}
options.achievements = {}
options.tutorialCompleted = false
options.slotMachineDrawCount = 0
options.doubleCurrency = false
options.lastCompletedChallengeIndex = 0
options.choosenCharacterId = "1"
options.gameOverSinceLastAd = 0
options.gameOverSinceLastRemoveAd = 5
options.gameOverSinceLastDoubleValueIAP = 5
options.gameOverSinceLastRateUs = 20
options.lastTimeAdShown = 0
options.appRated = false
options.firstLaunch = true
options.gameOverSinceLastFreeVideoReward = 0
options.unlockCharacterButtonIgnoreCount = 0
options.lastUnlockedScapeIndex = 1
options.lastTaskCompleted = 0
options.gameOverSinceLastUntilCharacterWidget = 0
options.gameOverSinceLastCpsWidgetShown = 0
options.screenshotHeight = 0
options.screenshotAdditionalY = 0
options.bonusWords = {}
options.installationReported = false
options.initGameNetworkLogin = false
options.adsUserId = math.random()

local db = nil
local dbBackup = nil

local function loadBoxSafely(name)
    if type(ice) ~= "table" or type(ice.loadBox) ~= "function" then
        print("[OPTIONS] ICE is unavailable; cannot load box " .. tostring(name))
        return nil
    end

    local ok, box = pcall(function()
        return ice:loadBox(name)
    end)

    if not ok then
        print("[OPTIONS] ICE loadBox failed for " .. tostring(name) .. ": " .. tostring(box))
        return nil
    end

    return box
end

local function retrieveSafely(box, key)
    if type(box) ~= "table" or type(box.retrieve) ~= "function" then
        return nil
    end

    local ok, value = pcall(function()
        return box:retrieve(key)
    end)

    if not ok then
        print("[OPTIONS] ICE retrieve failed for " .. tostring(key) .. ": " .. tostring(value))
        return nil
    end

    if type(value) == "table" then
        return value
    end

    return nil
end

local function loadSavedOptions()
    db = loadBoxSafely("options")
    dbBackup = loadBoxSafely("options_backup")

    local preference = nil
    if type(system) == "table" and type(system.getPreference) == "function" then
        local ok, result = pcall(system.getPreference, "app", "systemOptions")
        if ok then
            preference = result
        else
            print("[OPTIONS] getPreference failed: " .. tostring(result))
        end
    end

    -- The original bytecode assumed json.decode always returned a table.
    -- HTML5 storage can contain an empty, stale, or malformed preference.
    if preference ~= nil then
        local decodeOK, decoded = pcall(json.decode, preference)
        if decodeOK and type(decoded) == "table" then
            print("[OPTIONS] Loaded preferences from systemOptions")
            return decoded
        end

        print("[OPTIONS] systemOptions could not be decoded as a table; trying ICE storage")
        if not decodeOK then
            print("[OPTIONS] JSON decode error: " .. tostring(decoded))
        else
            print("[OPTIONS] JSON decode returned: " .. type(decoded))
        end
    end

    local recovered = retrieveSafely(db, "options")
    if recovered then
        print("[OPTIONS] Recovered preferences from ICE options box")
        return recovered
    end

    recovered = retrieveSafely(dbBackup, "options")
    if recovered then
        print("[OPTIONS] Recovered preferences from ICE backup box")
        return recovered
    end

    print("[OPTIONS] No valid saved options found; using game defaults")
    return {}
end

local tableMergeKeys = {
    players = true,
    optionsDefaults = true,
    dailyRewards = true,
    achievements = true,
    gameStatistics = true,
    charactersTable = true,
    activeScapes = true,
    previousChallengeProgress = true,
    currentChallengeProgressOpt = true,
    challengeTaskTimesCompleted = true,
    levels = true,
    todaysBest = true,
    currentDynamicChallenge = true,
    bonusWords = true,
    unlockedScapes = true
}

local function mergeDefaults(saved)
    if type(saved) ~= "table" then
        saved = {}
    end

    for key, defaultValue in pairs(options) do
        if type(defaultValue) ~= "function" then
            local shouldMerge = type(defaultValue) ~= "table" or tableMergeKeys[key]

            if shouldMerge and saved[key] == nil then
                if type(defaultValue) == "table" then
                    local copy = {}
                    for k, v in pairs(defaultValue) do
                        copy[k] = v
                    end
                    saved[key] = copy
                else
                    saved[key] = defaultValue
                end
            end

            if key == "optionsDefaults" then
                if type(saved[key]) ~= "table" then
                    saved[key] = {}
                end

                for k, v in pairs(defaultValue) do
                    if saved[key][k] ~= v then
                        saved[key][k] = v
                    end
                end
            end
        end
    end

    return saved
end

function options.init()
    local saved = loadSavedOptions()
    data = mergeDefaults(saved)
    -- Do not immediately overwrite potentially recoverable HTML5 storage.
    -- The next normal save will persist the repaired table.
    options.update(data, true)
end

function options.set(key, value, skipStore)
    options.save(key, value, skipStore)
end

function options.add(key, amount, skipStore)
    local current = data[key]
    if type(amount) ~= "number" or type(current) ~= "number" then
        if DEVELOPMENT_MODE then
            assert(false, "Cannot increment non number variable!")
        end
        return
    end

    options.save(key, current + amount, skipStore)
end

function options.get(key)
    return data[key]
end

function options.save(key, value, skipStore)
    data[key] = value
    if not skipStore then
        options.store()
    end
end

function options.update(newData, skipStore)
    if type(newData) ~= "table" then
        print("[OPTIONS] update received non-table; keeping existing data")
        return
    end

    data = newData
    if not skipStore then
        options.store()
    end
end

function options.store()
    if type(system) ~= "table" or type(system.setPreferences) ~= "function" then
        print("[OPTIONS] system.setPreferences unavailable; save skipped")
        return false
    end

    local okEncode, encoded = pcall(json.encode, data)
    if not okEncode or type(encoded) ~= "string" then
        print("[OPTIONS] JSON encode failed: " .. tostring(encoded))
        return false
    end

    local okStore, result = pcall(function()
        return system.setPreferences("app", { systemOptions = encoded })
    end)

    if not okStore then
        print("[OPTIONS] system.setPreferences failed: " .. tostring(result))
        return false
    end

    return true
end

options.init()

return options
